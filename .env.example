TP_DATABASE_URL=postgresql+psycopg://trust:trust@localhost:5432/trust
TP_PUBLIC_BASE_URL=http://localhost:8000
TP_DEV_MODE=true

# Later:
# TP_GOOGLE_CLIENT_ID=
# TP_GOOGLE_CLIENT_SECRET=
# TP_SMS_PROVIDER_KEY=
# TP_ID_VENDOR_KEY=
# TP_WHATSAPP_TOKEN=

# GitHub OAuth App (https://github.com/settings/developers), callback http://localhost:8000/oauth/github/callback
TP_GITHUB_CLIENT_ID=
TP_GITHUB_CLIENT_SECRET=
# Telegram bot from @BotFather. Run /setdomain on the bot with your host (localhost works for the widget)
TP_TELEGRAM_BOT_TOKEN=
TP_TELEGRAM_BOT_USERNAME=

# Veriphone (https://veriphone.io): phone line type + carrier, 1,000 free lookups / month
TP_VERIPHONE_KEY=
